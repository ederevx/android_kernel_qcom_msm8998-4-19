#include "dsi-panel-samsung_s6e3fc1_cmd.dtsi"

/* Display */
&mdss_dsi_active {
	mux {
		pins = "gpio94", "gpio21", "gpio62", "gpio66";
	};
	config {
		pins = "gpio94", "gpio21", "gpio62", "gpio66";
	};
};

&mdss_dsi_suspend {
	mux {
		pins = "gpio94", "gpio21", "gpio62", "gpio66";
	};
	config {
		pins = "gpio94", "gpio21", "gpio62", "gpio66";
	};
};

&soc {
	display_panel_poc: display_gpio_regulator@0 {
		compatible = "regulator-fixed";
		regulator-name = "display_panel_poc";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		gpio = <&tlmm 66 0>;
		enable-active-high;
		regulator-boot-on;
	};
};

/ {
	dsi_panel_pwr_supply_poc: dsi_panel_pwr_supply_poc {
		#address-cells = <1>;
		#size-cells = <0>;

		qcom,panel-supply-entry@0 {
			reg = <0>;
			qcom,supply-name = "poc";
			qcom,supply-min-voltage = <3000000>;
			qcom,supply-max-voltage = <3000000>;
			qcom,supply-enable-load = <0>;
			qcom,supply-disable-load = <0>;
		};

		qcom,panel-supply-entry@1 {
			reg = <1>;
			qcom,supply-name = "wqhd-vddio";
			qcom,supply-min-voltage = <1800000>;
			qcom,supply-max-voltage = <1950000>;
			qcom,supply-enable-load = <32000>;
			qcom,supply-disable-load = <80>;
		};
	};
};

&sde_dsi {
	qcom,dsi-default-panel = <&dsi_samsung_s6e3fc1_cmd>;
	poc-supply = <&display_panel_poc>;
};

&dsi_samsung_s6e3fc1_cmd {
	qcom,panel-supply-entries = <&dsi_panel_pwr_supply_poc>;
	qcom,platform-reset-gpio = <&tlmm 94 0>;
	qcom,platform-en-gpio = <&tlmm 21 0>;
	/delete-property/ qcom,esd-check-enabled;
};
