	};

	cam_sensor_front_0_mclk_active: cam_sensor_front_0_mclk_active {
		/* MCLK1 */
		mux {
			/* CLK, DATA */
			pins = "gpio14";
			function = "cam_mclk";
		};

		config {
			pins = "gpio14";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_sensor_front_0_mclk_suspend:
	cam_sensor_front_0_mclk_suspend {
		/* MCLK1 */
		mux {
			/* CLK, DATA */
			pins = "gpio14";
			function = "cam_mclk";
		};

		config {
			pins = "gpio14";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_sensor_front_0_active: cam_sensor_front_0_active {
		/* RESET, VDIG_EN */
		mux {
			pins = "gpio28", "gpio78";
			function = "gpio";
		};

		config {
			pins = "gpio28", "gpio78";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_sensor_front_0_suspend: cam_sensor_front_0_suspend {
		/* RESET, VDIG_EN */
		mux {
			pins = "gpio28", "gpio78";
			function = "gpio";
		};

		config {
			pins = "gpio28", "gpio78";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_sensor_front_0_ana_active: cam_sensor_front_0_ana_active {
