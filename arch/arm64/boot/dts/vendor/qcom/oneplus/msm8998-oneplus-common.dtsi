			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_sensor_rear_1_ana_suspend: cam_sensor_rear_1_ana_suspend {
		/* ACTUATOR POWER */
		mux {
			pins = "gpio23";
			function = "gpio";
		};

		config {
			pins = "gpio23";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_sensor_rear_1_vaf_active: cam_sensor_rear_1_vaf_active {
		/* ACTUATOR POWER */
		mux {
			pins = "gpio77";
			function = "gpio";
		};

		config {
			pins = "gpio77";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
