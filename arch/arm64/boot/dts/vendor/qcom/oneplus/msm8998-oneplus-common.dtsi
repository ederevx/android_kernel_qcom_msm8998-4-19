	qcom,camera@0 {
		cell-index = <0>;
		compatible = "qcom,camera";
		reg = <0x0>;
		qcom,csiphy-sd-index = <0>;
		qcom,csid-sd-index = <0>;
		qcom,mount-angle = <270>;
		qcom,led-flash-src = <&led_flash0>;
		qcom,actuator-src = <&actuator0>;
		qcom,eeprom-src = <&eeprom0>;
		cam_vio-supply = <&pm8998_lvs1>;
		cam_vana-supply = <&pmi8998_bob>;
		cam_vaf-supply = <&pm8998_l22>;
		cam_v_custom1-supply = <&pm8998_s3>;
		qcom,cam-vreg-name = "cam_vio",
		"cam_vana", "cam_vaf", "cam_v_custom1";
		qcom,cam-vreg-min-voltage = <0 3312000 2864000 1352000>;
		qcom,cam-vreg-max-voltage = <0 3600000 2864000 1352000>;
		qcom,cam-vreg-op-mode = <0 3600000 2864000 1352000>;
		qcom,gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_rear_0_mclk_active
				 &cam_sensor_rear_0_active
				 &cam_sensor_rear_0_ana_active
				 &cam_sensor_rear_0_actuator_vaf_active>;
		pinctrl-1 = <&cam_sensor_rear_0_mclk_suspend
				 &cam_sensor_rear_0_suspend
				 &cam_sensor_rear_0_ana_suspend
				 &cam_sensor_rear_0_actuator_vaf_suspend>;
		gpios = <&tlmm 13 0>, // mclk
			<&tlmm 30 0>, // reset
			<&tlmm 7 0>, // digital enable
			<&tlmm 27 0>, // ana enable
			<&tlmm 6 0>; // AF enable
		qcom,gpio-reset = <1>;
		qcom,gpio-vdig = <2>;
		qcom,gpio-vana = <3>;
		qcom,gpio-vaf = <4>;
		qcom,gpio-req-tbl-num = <0 1 2 3 4>;
		qcom,gpio-req-tbl-flags = <1 0 0 0 0>;
		qcom,gpio-req-tbl-label = "CAMIF_MCLK_0",
					"CAM_RESET_0",
					"CAM_VDIG_0",
					"CAM_VANA_0",
					"CAM_AF_EN_0";
		qcom,sensor-position = <0>;
		qcom,sensor-mode = <0>;
		qcom,cci-master = <0>;
		status = "ok";
		clocks = <&clock_mmss MCLK0_CLK_SRC>,
				<&clock_mmss MMSS_CAMSS_MCLK0_CLK>;
		clock-names = "cam_src_clk", "cam_clk";
		qcom,clock-rates = <24000000 0>;
	};

	qcom,camera@1 {
		cell-index = <1>;
		compatible = "qcom,camera";
		reg = <0x1>;
		qcom,csiphy-sd-index = <1>;
		qcom,csid-sd-index = <1>;
		qcom,mount-angle = <90>;
		qcom,led-flash-src = <&led_flash0>;
		qcom,actuator-src = <&actuator1>;
		qcom,eeprom-src = <&eeprom1>;
		cam_vio-supply = <&pm8998_lvs1>;
		cam_vana-supply = <&pmi8998_bob>;
		cam_vaf-supply = <&pmi8998_bob>;
		cam_v_custom1-supply = <&pm8998_s3>;
		qcom,cam-vreg-name = "cam_vio",
		"cam_vana", "cam_vaf", "cam_v_custom1";
		qcom,cam-vreg-min-voltage = <0 3312000 3312000 1352000>;
		qcom,cam-vreg-max-voltage = <0 3600000 3600000 1352000>;
		qcom,cam-vreg-op-mode = <0 3600000 3600000 1352000>;
		qcom,gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_rear_1_mclk_active
				 &cam_sensor_rear_1_active
				 &cam_sensor_rear_1_ana_active
				 &cam_sensor_rear_1_vaf_active>;
		pinctrl-1 = <&cam_sensor_rear_1_mclk_suspend
				 &cam_sensor_rear_1_suspend
				 &cam_sensor_rear_1_ana_suspend
				 &cam_sensor_rear_1_vaf_suspend>;
		gpios = <&tlmm 15 0>, // mclk
			<&tlmm 9 0>, // reset
			<&tlmm 8 0>, // digital enable
			<&tlmm 23 0>, // ana enable
			<&tlmm 77 0>; // AF enable
		qcom,gpio-reset = <1>;
		qcom,gpio-vdig = <2>;
		qcom,gpio-vana = <3>;
		qcom,gpio-vaf = <4>;
		qcom,gpio-req-tbl-num = <0 1 2 3 4>;
		qcom,gpio-req-tbl-flags = <1 0 0 0 0>;
		qcom,gpio-req-tbl-label = "CAMIF_MCLK_1",
					"CAM_RESET_1",
					"CAM_VDIG_1",
					"CAM_VANA_1",
					"CAM_AF_EN_1";
		qcom,sensor-position = <0>;
		qcom,sensor-mode = <0>;
		qcom,cci-master = <1>;
		status = "ok";
		clocks = <&clock_mmss MCLK2_CLK_SRC>,
			<&clock_mmss MMSS_CAMSS_MCLK2_CLK>;
		clock-names = "cam_src_clk", "cam_clk";
		qcom,clock-rates = <24000000 0>;
	};

	qcom,camera@2 {
		cell-index = <2>;
		compatible = "qcom,camera";
		reg = <0x02>;
		qcom,csiphy-sd-index = <2>;
		qcom,csid-sd-index = <2>;
		qcom,mount-angle = <90>;
		qcom,eeprom-src = <&eeprom2>;
		cam_vio-supply = <&pm8998_lvs1>;
		cam_vana-supply = <&pmi8998_bob>;
		cam_vdig-supply = <&pm8998_s3>;
		qcom,cam-vreg-name = "cam_vio", "cam_vana", "cam_vdig";
		qcom,cam-vreg-min-voltage = <0 3312000 1352000>;
		qcom,cam-vreg-max-voltage = <0 3600000 1352000>;
		qcom,cam-vreg-op-mode = <0 3600000 1352000>;
		qcom,gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_front_0_mclk_active
				 &cam_sensor_front_0_active
				 &cam_sensor_front_0_ana_active>;
		pinctrl-1 = <&cam_sensor_front_0_mclk_suspend
				 &cam_sensor_front_0_suspend
				 &cam_sensor_front_0_ana_suspend>;
		gpios = <&tlmm 14 0>,// mclk
			<&tlmm 28 0>,// reset
			<&tlmm 78 0>,// vdig enable
			<&tlmm 85 0>;// vana enable
		qcom,gpio-reset = <1>;
		qcom,gpio-vdig = <2>;
		qcom,gpio-vana = <3>;
		qcom,gpio-req-tbl-num = <0 1 2 3>;
		qcom,gpio-req-tbl-flags = <1 0 0 0>;
		qcom,gpio-req-tbl-label = "CAMIF_MCLK_2",
					  "CAM_RESET_2",
					  "CAM_VDIG_2",
					  "CAM_VANA_2";
		qcom,sensor-position = <1>;
		qcom,sensor-mode = <0>;
		qcom,cci-master = <0>;
		status = "ok";
		clocks = <&clock_mmss MCLK1_CLK_SRC>,
			<&clock_mmss MMSS_CAMSS_MCLK1_CLK>;
		clock-names = "cam_src_clk", "cam_clk";
		qcom,clock-rates = <24000000 0>;
	};
};

&pm8998_gpios {
	camera_sensor_2_vdig: camera_sensor_2_vdig {
		/* GPIO 9 - CAMERA SENSOR 2 VDIG */
		pins = "gpio9";
		function = "normal";
		output-low;
		bias-disable;
		power-source = <0>;
	};

	camera_sensor_0_vdig: camera_sensor_0_vdig {
		/* GPIO 20 - CAMERA SENSOR 0 VDIG */
		pins = "gpio20";
		function = "normal";
		output-low;
		bias-disable;
		power-source = <1>;
	};
};

/* Firmware */
&firmware {
	/delete-node/ android;
	android {
		compatible = "android,firmware";
		fstab {
			compatible = "android,fstab";
			boot_devices = "soc/1da4000.ufshc";
			vendor {
				compatible = "android,vendor";
				dev = "/dev/block/platform/soc/1da4000.ufshc/by-name/vendor";
				type = "ext4";
				mnt_flags = "ro,barrier=1,discard";
				fsmgr_flags = "wait";
				status = "disabled";
			};
			system {
				compatible = "android,system";
				dev = "/dev/block/platform/soc/1da4000.ufshc/by-name/system";
				type = "ext4";
				mnt_flags = "ro,barrier=1,discard";
				fsmgr_flags = "wait";
				status = "disabled";
			};
		};
	};
};

/* Thermistors */
&pm8998_vadc {
	xo_therm {
		label = "xo_therm";
		reg = <ADC_XO_THERM_PU2>;
		qcom,decimation = <1024>;
		qcom,pre-scaling = <1 1>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,avg-samples = <1>;
	};

	msm_therm {
		label = "msm_therm";
		reg = <ADC_AMUX_THM1_PU2>;
		qcom,decimation = <1024>;
		qcom,pre-scaling = <1 1>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,avg-samples = <1>;
	};

	ufs_therm {
		label = "ufs_therm";
		reg = <ADC_AMUX_THM2_PU2>;
		qcom,decimation = <1024>;
		qcom,pre-scaling = <1 1>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,avg-samples = <1>;
	};

	pa_therm0 {
		label = "pa_therm0";
		reg = <ADC_AMUX_THM3_PU2>;
		qcom,decimation = <1024>;
		qcom,pre-scaling = <1 1>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,avg-samples = <1>;
	};

	pa_therm1 {
		label = "pa_therm1";
		reg = <ADC_AMUX_THM4_PU2>;
		qcom,decimation = <1024>;
		qcom,pre-scaling = <1 1>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,avg-samples = <1>;
	};

	quiet_therm {
		label = "quiet_therm";
		reg = <ADC_AMUX_THM5_PU2>;
		qcom,decimation = <1024>;
		qcom,pre-scaling = <1 1>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,avg-samples = <1>;
	};
};

&pm8998_adc_tm {
	io-channels = <&pm8998_vadc ADC_VPH_PWR>,
		<&pm8998_vadc ADC_XO_THERM_PU2>,
		<&pm8998_vadc ADC_AMUX_THM1_PU2>,
		<&pm8998_vadc ADC_AMUX_THM2_PU2>,
		<&pm8998_vadc ADC_AMUX_THM3_PU2>,
		<&pm8998_vadc ADC_AMUX_THM4_PU2>,
		<&pm8998_vadc ADC_AMUX_THM5_PU2>;

	xo_therm {
		reg = <ADC_XO_THERM_PU2>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};

	msm_therm {
		reg = <ADC_AMUX_THM1_PU2>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};

	ufs_therm {
		reg = <ADC_AMUX_THM2_PU2>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};

	pa_therm0 {
		reg = <ADC_AMUX_THM3_PU2>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};

	pa_therm1 {
		reg = <ADC_AMUX_THM4_PU2>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};

	quiet_therm {
		reg = <ADC_AMUX_THM5_PU2>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};
};

/* Thermals */
&thermal_zones {
	/* Reconfigure LMH to trigger at 85C */
	lmh-dcvs-01 {
		trips {
			active-config {
				temperature = <85000>;
				hysteresis = <20000>;
			};
		};
	};

	lmh-dcvs-00 {
		trips {
			active-config {
				temperature = <85000>;
				hysteresis = <20000>;
			};
		};
	};

	/* Reconfigure GPU throttling to trigger at 85C */
	gpu-virt-max-step {
		trips {
			gpu-trip0 {
				temperature = <85000>;
				hysteresis = <0>;
			};
		};
	};

	/* Configure BCL SOC threshold */
	soc {
		trips {
			low-soc {
				temperature = <5>;
			};
		};
	};

	xo-therm-adc {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&pm8998_adc_tm ADC_XO_THERM_PU2>;
		thermal-governor = "user_space";
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	msm-therm-adc {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&pm8998_adc_tm ADC_AMUX_THM1_PU2>;
		thermal-governor = "user_space";
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	ufs-therm-adc {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&pm8998_adc_tm ADC_AMUX_THM2_PU2>;
		thermal-governor = "user_space";
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	pa-therm0-adc {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&pm8998_adc_tm ADC_AMUX_THM3_PU2>;
		thermal-governor = "user_space";
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	pa-therm1-adc {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&pm8998_adc_tm ADC_AMUX_THM4_PU2>;
		thermal-governor = "user_space";
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	quiet-therm-adc {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&pm8998_adc_tm ADC_AMUX_THM5_PU2>;
		thermal-governor = "user_space";
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};
};

/* Disable pcie0 as its wake-gpio is used for NFC */
/* NFC */
&pcie0 {
	status = "disabled";
};

&pcie0_clkreq_default {
	mux {
		function = "gpio";
	};
};

&pm8998_gpios {
	nfc_clk {
		nfc_clk_default: nfc_clk_default {
			pins = "gpio21";
			function = "normal";
			input-enable;
			bias-pull-down;
			power-source = <1>;
		};
	};
};

&i2c_6 { /* BLSP1 QUP6 (NFC) */
	status = "okay";

	/delete-node/ nq@28;

	pn5xx@28 {
		compatible = "nxp,pn547";
		nxp,dev_name = "nq-nci";
		reg = <0x28>;
		interrupt-parent = <&tlmm>;
		interrupts = <92 IRQ_TYPE_LEVEL_HIGH>;
		nxp,irq_gpio = <&tlmm 92 0x00>;
		nxp,dwld_en = <&tlmm 93 0x00>;
		nxp,ven = <&tlmm 12 0x00>;
		nxp,clk_req = <&pm8998_gpios 21 0x00>;
		nxp,pvdd_en = <&tlmm 37 0x00>;
		nxp,use_pn544;
		clocks = <&clock_rpmcc RPM_SMD_LN_BB_CLK3_PIN>;
		clock-names = "nfc_clk";
		pinctrl-names = "pn547-active", "pn547-inactive";
		pinctrl-0 = <&nfc_int_active 
				&nfc_enable_active
				&nfc_clk_default>;
		pinctrl-1 = <&nfc_int_suspend &nfc_enable_suspend>;
	};
};

/* Debug UART */
&uartblsp2dm1 {
	pinctrl-names = "uart_active", "uart_deactive";
	pinctrl-0 = <&uart_console_active>;
	pinctrl-1 = <&uart_console_deactive>;
};

/* Restart */
&soc {
	restart@10ac000 {
		qcom,force-warm-reboot;
	};
};
