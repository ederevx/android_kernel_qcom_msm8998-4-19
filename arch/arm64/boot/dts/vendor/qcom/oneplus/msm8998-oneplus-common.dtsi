		};

		config {
			pins = "gpio9","gpio8";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_sensor_rear_1_suspend: cam_sensor_rear_1_suspend {
		/* RESET, STANDBY */
		mux {
			pins = "gpio9","gpio8";
			function = "gpio";
		};
		config {
			pins = "gpio9","gpio8";
