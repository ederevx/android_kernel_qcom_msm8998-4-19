			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_sensor_rear_1_ana_active: cam_sensor_rear_1_ana_active {
		/* ACTUATOR POWER */
		mux {
			pins = "gpio23";
			function = "gpio";
		};

		config {
